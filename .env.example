# Development-only values. Copy to .env; never use these values in production.
DJANGO_SECRET_KEY=replace-this-local-development-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
DB_NAME=practicallab_dev
DB_USER=practicallab_dev
DB_PASSWORD=local-development-only
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
API_INTERNAL_URL=http://api:8000
PUBLIC_WEB_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=no-reply@practicallab.africa
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
PASSWORD_RESET_TIMEOUT=3600
# Production only: generate with Fernet.generate_key().decode(); keep stable and secret.
STAFF_MFA_ENCRYPTION_KEY=
